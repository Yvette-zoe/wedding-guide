# 扣子个人访问令牌，仅复制到 .env.local 使用，不要提交真实值
COZE_PAT=pat_xxxxxxxxxxxxxxxxx

# 已发布的 wf_list_places 工作流
COZE_WF_LIST_PLACES=7671226620824371235

# 高德 Web 服务 API Key（路径规划、天气查询用），仅复制到 .env.local 使用
AMAP_KEY=your_amap_key_here

# DeepSeek API Key，用于婚礼助手多轮对话与行程规划，仅复制到 .env.local 使用
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# deepseek-chat / deepseek-reasoner 已于 2026-07-24 退役，
# 分别对应 deepseek-v4-flash 的非思考/思考模式，此处默认用非思考模式
DEEPSEEK_MODEL=deepseek-v4-flash

# 利川市高德 adcode，天气查询用
LICHUAN_ADCODE=422802

# 婚礼邀请码（P0 访问控制）：链接带 ?code= 与之一致才可对话/查驾车时长
# 生产环境（Vercel）务必配置；本地未配置则跳过校验便于开发
WEDDING_INVITE_CODE=XY2026
